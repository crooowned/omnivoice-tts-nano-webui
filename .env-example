# Copy this file to .env for local Docker Compose runs.

# Frontend
FRONTEND_PORT=7863
UI_LANG=en
API_URL=http://localhost:8883
STT_URL=http://localhost:8882

# Backend model/runtime
OMNIVOICE_MODEL=k2-fsa/OmniVoice
# Optional override used only by docker-compose.rocm.yaml
ROCM_PYTORCH_IMAGE=rocm/pytorch:rocm7.2.4_ubuntu24.04_py3.12_pytorch_2.10.0_ORT_1.23.2
DEVICE=cuda
DTYPE=float16
LM_QUANT=nf4
LOAD_ASR=false
MODEL_TTL_SECONDS=3600
MAX_VRAM_GB=4
CPU_OFFLOAD=false
CPU_OFFLOAD_GB=8
OFFLOAD_DIR=/app/offload
AUDIO_TOKENIZER_DEVICE=
CHUNK_CHARS=200
CHUNK_GAP_MS=150
TURBO_STEPS=4
DYNAMIC_STEPS_MIN=4
DYNAMIC_STEPS_MAX=64
DYNAMIC_DESIRED_SPEED=4.0
DYNAMIC_STEP_DELTA=4

# Backend storage/log paths inside the container
MODELS_DIR=/app/models
VOICES_DIR=/app/voices
LOG_FILE=/app/logs/backend.log
